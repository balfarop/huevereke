# --- Google OAuth ---
# Crear en https://console.cloud.google.com/apis/credentials
# Tipo: OAuth Client ID > Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con un "Authorized redirect URI" configurado en Google Cloud
GOOGLE_REDIRECT_URI=https://tu-app.fly.dev/auth/callback

# Correos permitidos, separados por coma (tú y tu esposa)
ALLOWED_EMAILS=tu-correo@gmail.com,correo-esposa@gmail.com

# --- Sesión ---
# Genera uno único, ej: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Claude Agent SDK ---
# Generado una sola vez corriendo: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Solo en Windows: ruta al ejecutable nativo instalado con
# irm https://claude.ai/install.ps1 | iex (evita el error
# "Failed to start Claude Code: [WinError 193]"). Déjalo vacío en Linux/Mac.
CLAUDE_CLI_PATH=C:\Users\bryan.alfaro\.local\bin\claude.exe

SESSION_IDLE_MINUTES=60

# --- Consulta directa a Notion (solo para el sidebar de últimas semanas) ---
# DISTINTO del login OAuth que usa el agente (mcp-remote) — esto es un
# token de integración interna, para una consulta fija sin pasar por el
# Agent SDK. Crear en https://www.notion.so/my-integrations y compartir la
# página "Menu Semanal" con esa integración.
NOTION_TOKEN=
# UUID de la fuente de datos de "Semanas" (sin el prefijo "collection://").
# Ya tiene un valor por defecto conocido en config.py — déjala comentada
# salvo que necesites cambiarlo.
# SEMANAS_DATA_SOURCE_ID=cb2d66b6-1ff9-4bc4-8717-1bcd19733aa6
# Igual para "Platos" y "Receta_Insumo" — esta última se agregó en la
# Fase 6 (precargado del vocabulario de combos de Ensalada).
# PLATOS_DATA_SOURCE_ID=8adf66ab-2faa-4d73-ba28-43f6dda95b36
# RECETA_INSUMO_DATA_SOURCE_ID=cd28e58f-a900-49e5-9456-8e5b5d0bb4ac

# Página fija de "zona de pruebas" para el modo prueba de la web (ver
# app/conversation_tools.py y el paso 7 de propuesta-menu-semanal) —
# opcional. Si la dejas vacía, la app simplemente no ofrece la opción de
# guardar notas de conversación cuando corras una propuesta en modo
# prueba (el resto del modo prueba funciona igual).
#
# Para configurarla: crea UNA página cualquiera en Notion (ej. titulada
# "🧪 Huevereke — pruebas"), compártela con la MISMA integración interna
# de NOTION_TOKEN de arriba (no con el login OAuth del agente — "..." ->
# "Conexiones" -> tu integración, igual que con las bases de arriba), y
# pega acá su ID (se ve en la URL de la página, el bloque de 32
# caracteres justo antes de cualquier "?" — con o sin guiones, cualquiera
# de los dos formatos funciona).
TEST_NOTES_PARENT_PAGE_ID=

# --- Caché local (app/menu_cache) — paso 1 en construcción, ver README ---
# Estos dos SÍ hacen falta completarlos — a diferencia de los 3 de arriba,
# no tienen valor por defecto en config.py. Sácalos con notion-fetch sobre
# el link de entrada en notion-interaccion/references/notion-schema.md, o
# pídeselos una vez al agente en Claude Desktop.
#
# IMPORTANTE — no basta con poner el ID acá: tu integración interna (la
# que sea que hayas nombrado en https://www.notion.so/my-integrations,
# probablemente "HueverekeWeb") tiene que estar además compartida con
# CADA una de estas 2 bases, no solo con Semanas/Platos/Receta_Insumo
# como hasta ahora. Si no, sync.py falla con 404 "object_not_found" al
# llegar a esa base, aunque el ID esté bien puesto acá. Para compartirla:
# abre la base en Notion -> "..." (arriba a la derecha) -> "Conexiones"
# ("Connections") -> busca y agrega tu integración. Repite para las 2.
INSUMOS_DATA_SOURCE_ID=
SEMANA_INSUMO_FAMILIAR_DATA_SOURCE_ID=
# Ruta del SQLite local. Por defecto vive en la raíz del proyecto
# (menu_cache.sqlite3) — déjala vacía salvo que quieras otra ubicación.
# MENU_CACHE_DB_PATH=

# Cada cuántos minutos como máximo se vuelve a sincronizar el caché local
# desde Notion de forma automática (arranque, inicio de conversación y
# guardado de una Semana). Default: 30.
# MENU_CACHE_MAX_AGE_MINUTES=30
